VITE_BACKEND_URL=http://127.0.0.1:8008

# Geometry wire format this build defaults to.
#   v2 — GPU-ready typed arrays (packGPUBuffers). Required for large grounds:
#        v1 cannot fit a 2000x2000 scene inside Electron's 4 GB heap cage.
#   v1 — per-primitive records. The original path; unset means v1.
# Overridable at runtime from DevTools: __heliosPerf.gpuOn() / .gpuOff()
VITE_GEOMETRY_FORMAT=v1
