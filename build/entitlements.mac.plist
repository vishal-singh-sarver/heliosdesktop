<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the signed Helios.app.

  Notarization requires hardened runtime, which by default blocks several
  things Electron and a PyInstaller sidecar need. Each key below is here for a
  specific reason - do not prune without testing a signed build:

    allow-jit / allow-unsigned-executable-memory
        V8 JIT-compiles JavaScript at runtime. Without these the renderer
        crashes immediately on launch under hardened runtime.

    disable-library-validation
        The PyInstaller backend (heliosgui_backend) loads its bundled shared
        libraries at runtime; these are signed with our Developer ID but are
        not part of the app's own code signature. Library validation would
        refuse to load them.

    network.client / network.server
        The app talks to the backend over local HTTP (VITE_BACKEND_URL,
        http://localhost:8000) - the renderer is the client, the sidecar is
        the server.

    files.user-selected.read-write
        File open/save dialogs.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
